# Get this token from @BotFather. Required for startup.
TELEGRAM_BOT_TOKEN=

# Select one provider: gigachat or vsegpt.
AI_PROVIDER=gigachat

# Authorization Key from GigaChat. Used only when AI_PROVIDER=gigachat.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# Key from https://vsegpt.ru/User/API. Used only when AI_PROVIDER=vsegpt.
VSEGPT_API_KEY=
VSEGPT_MODEL=openai/gpt-5.6-sol-pro
VSEGPT_BASE_URL=https://api.vsegpt.ru/v1
VSEGPT_MAX_TOKENS=200

# Image analysis (photo caption: ?? question).
VSEGPT_VISION_MODEL=vis-google/gemini-3-flash-pre
VISION_PROMPT=Reply briefly in Russian like in a messenger. Do not use Markdown.

# Optional bot behavior settings
SYSTEM_PROMPT=Reply briefly in Russian unless another language is requested. Be direct. No Markdown. Max 2 sentences.
ENGLISH_COACH_PROMPT=Act as a strict but friendly English teacher in an informal chat. For every user message, give a natural conversational English version without changing meaning, then briefly explain the changes in English. Be concise. No Markdown, greetings, or praise.
SOFT_CONTEXT_LIMIT=8
HARD_CONTEXT_LIMIT=20
KEEP_LAST_MESSAGES=2
MEMORY_FILE=memory.json
MEMORY_MAX_TOKENS=150
MEMORY_PROMPT=Extract durable facts only. Return plain text, never JSON or Markdown. One fact per line: CHAT_FACT: fact or USER_FACT: user_id|name|fact. If none, return EMPTY.
MAX_ENGLISH_HISTORY_MESSAGES=1
REMINDERS_FILE=reminders.json
REMINDER_SCHEDULE_PROMPT=Определи время напоминания из сообщения пользователя. Учитывай текущее время и часовой пояс. Верни только две строки: TIME: YYYY-MM-DD HH:MM и TEXT: краткий смысл напоминания. Если время определить нельзя, верни TIME: NONE. Если пользователь явно указал прошедшую дату или время, оставь его прошедшим: бот должен выполнить такую задачу сразу. Для времени без даты выбирай следующее наступление.
REMINDER_PROMPT=Пойми смысл исходного текста напоминания и сформулируй его естественно. Напиши одну короткую фразу на русском. Не используй шаблон, не добавляй новые факты, время, приветствие или Markdown. Верни только текст напоминания.
BOT_TIMEZONE=Europe/Moscow
REMINDER_POLL_SECONDS=15
LOG_LEVEL=INFO
